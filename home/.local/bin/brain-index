#!/usr/bin/env bash
# brain-index — regenerate ~/brain/00-index.md from the cards and area notes.
#
# Each card's first "> " line is its summary and its "**Status" line its status.
# Refuses to overwrite a hand-written index unless run with --init.
set -uo pipefail

BRAIN=${BRAIN_DIR:-$HOME/brain}
INDEX=$BRAIN/00-index.md
MARK='<!-- generated by brain-index: edit the cards, not this file -->'

if [[ -f $INDEX ]] && ! grep -qF "$MARK" "$INDEX" && [[ ${1:-} != --init ]]; then
  echo "brain-index: $INDEX is hand-written; run 'brain-index --init' once to take it over" >&2
  exit 0
fi

cell() { sed -e 's/|/\\|/g' <<<"$1"; }
summary() { grep -m1 '^> ' "$1" | sed 's/^> //'; }
status() { grep -m1 -i '^\*\*status' "$1" | sed -E 's/^\*\*[Ss]tatus[^*]*\*\*:? *//'; }

{
  echo "# Brain — Master Index"
  echo
  echo "$MARK"
  echo
  echo "> Long-term memory for your repos and infrastructure. Each \`repos/<name>.md\` is a short **card** (current truth, ≤9.5k chars) that Claude Code injects at session start; \`logs/<name>.md\` holds the dated history."
  echo
  echo "## Repos"
  echo
  echo "| Repo | What it is | Status |"
  echo "|---|---|---|"
  for f in "$BRAIN"/repos/*.md; do
    n=$(basename "$f" .md)
    echo "| [[repos/$n\|$n]] | $(cell "$(summary "$f")") | $(cell "$(status "$f")") |"
  done
  echo
  echo "## Areas"
  echo
  for f in "$BRAIN"/areas/*.md; do
    n=$(basename "$f" .md)
    s=$(summary "$f"); echo "- [[areas/$n]]${s:+ — $s}"
  done
  echo
  echo "## How to use this vault"
  echo
  echo "- **Cards** (\`repos/\`): edit in place; delete facts that stop being true; keep under 9,500 chars."
  echo "- **Logs** (\`logs/\`): dated, append-only evidence and narrative. When a log entry changes the truth, update the card in the same session."
  echo "- **New repo:** copy [[templates/card]]."
  echo "- **Compaction:** run the \`brain-distill\` skill when a card drifts or a log grows."
} > "$INDEX.tmp" && mv "$INDEX.tmp" "$INDEX"
