#!/usr/bin/env bash
# brain-phi-scan — flag PHI-shaped key/value text before it reaches git.
#
#   brain-phi-scan --staged [repo]   scan lines added in the staged diff (used by brain-sync)
#   brain-phi-scan FILE...           scan whole files (audits)
#
# Prints "file:line: <rule>" (never the matched value) and exits 1 on any hit.
# The placeholder values 12345678 / V12345678 are always allowed.
set -uo pipefail

RULES=(
  'mrn|\bMRN\b[^0-9A-Za-z\n]{0,6}[A-Z]?[0-9]{5,}'
  'visit-number|\bvisit[ _-]?(number|no|num|id)\b[^0-9\n]{0,6}V?[0-9]{5,}'
  'account-number|\b(HAR|FIN|account[ _-]?(number|no|num))\b[^0-9\n]{0,6}V?[0-9]{5,}'
  'patient-id|\bpatient[ _-]?(id|number|no)\b[^0-9\n]{0,6}[0-9]{5,}'
  'dob|\b(DOB|date of birth|birth[ _-]?date)\b[^0-9\n]{0,6}[0-9]{1,4}[-/][0-9]{1,2}[-/][0-9]{1,4}'
  'ssn|\bSSN\b[^0-9\n]{0,6}[0-9]{3}-?[0-9]{2}-?[0-9]{4}|\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b'
)
ALLOW='\b(12345678|V12345678)\b'

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

if [[ ${1:-} == --staged ]]; then
  git -C "${2:-.}" diff --cached -U0 --no-color --diff-filter=AM | awk '
    /^\+\+\+ b\// { f = substr($0, 7); next }
    /^@@/ { split($3, a, ","); n = substr(a[1], 2) + 0; next }
    /^\+/ && !/^\+\+\+/ { printf "%s\t%d\t%s\n", f, n, substr($0, 2); n++ }
  ' > "$tmp/index"
else
  for f in "$@"; do awk -v f="$f" '{ printf "%s\t%d\t%s\n", f, NR, $0 }' "$f"; done > "$tmp/index"
fi

cut -f3- "$tmp/index" | sed -E "s/$ALLOW//g" > "$tmp/text"
: > "$tmp/hits"
for spec in "${RULES[@]}"; do
  name=${spec%%|*}; re=${spec#*|}
  grep -niP -- "$re" "$tmp/text" | cut -d: -f1 | while read -r n; do
    sed -n "${n}p" "$tmp/index" | awk -F'\t' -v r="$name" '{ print $1 ":" $2 ": " r }'
  done >> "$tmp/hits"
done

if [[ -s $tmp/hits ]]; then sort -u "$tmp/hits"; exit 1; fi
exit 0
